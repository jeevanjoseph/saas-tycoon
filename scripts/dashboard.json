{
  "dashboard": {
    "uid": "fexfllvslea69e",
    "title": "SaaS Tycoon Server: OpenTelemetry Metrics",
    "tags": ["opentelemetry", "nodejs", "saas-tycoon"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "row",
        "title": "HTTP Server Metrics",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false,
        "panels": []
      },
      {
        "type": "stat",
        "title": "HTTP Requests (Count)",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-us-phoenix-1-fa"
        },
        "targets": [
          {
            "expr": "sum(http_server_duration_count{app=\"saas-tycoon-server\"})",
            "legendFormat": "Total HTTP Requests"
          }
        ]
      },
      {
        "type": "stat",
        "title": "HTTP Errors (4xx/5xx)",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-us-phoenix-1-fa"
        },
        "targets": [
          {
            "expr": "sum(http_server_duration_count{http_status_code=~\"4..|5..\",app=\"saas-tycoon-server\"})",
            "legendFormat": "HTTP Errors"
          }
        ]
      },
      {
        "type": "stat",
        "title": "HTTP Request Duration (ms)",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-us-phoenix-1-fa"
        },
        "targets": [
          {
            "expr": "rate(http_server_duration_sum{app=\"saas-tycoon-server\"}[5m]) / rate(http_server_duration_count{app=\"saas-tycoon-server\"}[5m])",
            "legendFormat": "Avg Duration"
          }
        ]
      },
      {
        "type": "heatmap",
        "title": "HTTP Request Duration Histogram",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-us-phoenix-1-fa"
        },
        "targets": [
          {
            "expr": "sum by (le) (rate(http_server_duration_bucket{app=\"saas-tycoon-server\"}[5m]))",
            "legendFormat": "le={{le}}"
          }
        ],
        "yAxis": { "format": "ms" }
      },
      {
        "type": "table",
        "title": "HTTP Request Breakdown",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-us-phoenix-1-fa"
        },
        "targets": [
          {
            "expr": "sum by (http_method, http_route, http_status_code) (rate(http_server_duration_count{app=\"saas-tycoon-server\"}[5m]))",
            "legendFormat": "{{http_method}} {{http_route}} {{http_status_code}}"
          }
        ]
      },
